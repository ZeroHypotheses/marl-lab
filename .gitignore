# The MARL textbook is free to download for personal use but is NOT
# redistributable. This repo has a public remote — keep the PDF local.
book/*
!book/README.md
!book/.gitkeep

# Extracted book text (derivative of the copyrighted PDF)
book/text/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Experiment outputs
experiments/**/runs/
experiments/**/outputs/
experiments/**/wandb/
experiments/**/*.pt
experiments/**/*.ckpt

# Harness-generated mirror of .claude/skills/ (identical content, regenerated
# on demand). The skills' real instructions live in workflows/, which every
# harness reaches via AGENTS.md -- so this mirror adds nothing but drift risk.
.agents/

# Understand-Anything generated artifacts
.understand/
understand-output/

# OS / editor
.DS_Store
.idea/
*.swp
